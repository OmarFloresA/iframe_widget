<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_color" model="ir.ui.view">
        <field name="name">res.company.form.color</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <!-- Añadir el campo de color justo debajo del nombre de la compañía -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="color" widget="color_list"/>
            </xpath>
        </field>
    </record>
</odoo>
